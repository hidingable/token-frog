    "accounts.privacy": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认不读取任何其他应用的登录信息。请逐个选择要关联的来源，随时可以断开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other app’s login is read by default. Choose each source to link; disconnect at any time."
          }
        }
      }
    },
