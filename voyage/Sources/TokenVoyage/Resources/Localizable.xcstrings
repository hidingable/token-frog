    "letter.welcomeBody": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我刚到这间小邮局，还不知道你的习惯。我先理好邮包，再认认门前的路。明天开始，我会把路上的见闻写信告诉你。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’ve just arrived at this little post office, so I’m still getting to know you. I’ll pack my mailbag and find my way around. Starting tomorrow, I’ll write to you about what I see along the way."
          }
        }
      }
    },
