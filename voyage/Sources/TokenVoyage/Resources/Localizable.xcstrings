    "accounts.localConsent": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点“关联”后，会读取 %@ 在本机的登录信息，仅用于向它的服务商读取额度，用完不保存。只读，不会替你刷新令牌。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link reads %@’s local login only to request quota from its provider, then discards it. Read only; tokens are never refreshed for you."
          }
        }
      }
    },
    "accounts.keychainConsent": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 会优先读取钥匙串，系统可能弹窗确认（最多等待 10 秒），其次读取本机凭据文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude checks Keychain first; macOS may ask for permission (up to 10 seconds), then the local credentials file is tried."
          }
        }
      }
    },
    "accounts.tokscaleConsent": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点“关联”后，tokscale usage 会读取本机所有受支持工具的登录信息并请求服务商。此来源统一授权；列表会排除 Codex 和 Claude。Tokotoko 不保存凭据，也不会替你刷新令牌。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link authorizes tokscale usage to read local logins for all supported tools and contact their providers. This source uses one shared consent; Codex and Claude are excluded from its displayed results. Tokotoko does not save credentials or refresh tokens for you."
          }
        }
      }
    },
