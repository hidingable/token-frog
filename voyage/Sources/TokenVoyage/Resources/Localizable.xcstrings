    "quota.stale": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是旧数值，最后成功读取于 %@。恢复后会自动重试，也可手动刷新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing an older reading from %@. Automatic retries are scheduled; you can also refresh manually."
          }
        }
      }
    },
    "quota.expired": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
