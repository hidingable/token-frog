# No env file is loaded by default. Optionally set HUB_ENV_FILE to an explicit path.
# Existing process environment values take precedence (Node process.loadEnvFile).
# HUB_ENV_FILE=/absolute/path/to/private.env
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=token
DB_USERNAME=your-database-user
DB_PASSWORD=your-database-password
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=your-model-id
# Optional OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=17322
HOST=127.0.0.1
# false, true, or comma-separated trusted proxy IPs/CIDRs
TRUST_PROXY=false
# Relative to the working directory; run commands from voyage/hub.
HUB_TAGS_FILE=../Content/tags.json
HUB_PUBLISHED_IDS_FILE=../Content/published-ids.txt
HUB_ITEMS_FILE=../Content/items
# Directories for local runs; image uses generated cities.txt and pets.json.
HUB_CITIES_FILE=../Content/cities
HUB_PETS_FILE=../Content/pets
WISH_TIMEOUT_MS=2500
RATE_IP_CAPACITY=120
RATE_IP_REFILL_PER_SECOND=2
RATE_DEVICE_CAPACITY=60
RATE_DEVICE_REFILL_PER_SECOND=1
WISH_RATE_IP_CAPACITY=10
WISH_RATE_IP_REFILL_PER_SECOND=0.1666666667
WISH_RATE_DEVICE_CAPACITY=5
WISH_RATE_DEVICE_REFILL_PER_SECOND=0.0833333333
STAY_RATE_IP_CAPACITY=20
STAY_RATE_IP_REFILL_PER_SECOND=0.0166666667
STAY_RATE_DEVICE_CAPACITY=6
STAY_RATE_DEVICE_REFILL_PER_SECOND=0.0033333333
